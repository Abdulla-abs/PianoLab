<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.PianoLab.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PianoLab.LargeComponent</item>
    </style>

    <style name="Widget.PianoLab.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="backgroundTint">?attr/colorPrimaryContainer</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PianoLab.SmallComponent</item>
    </style>

    <style name="ThemeOverlay.PianoLab.ChordPickerDialog" parent="ThemeOverlay.Material3.Light">
        <item name="android:colorBackground">@color/chord_picker_dialog_bg</item>
        <item name="colorSurface">@color/chord_picker_dialog_bg</item>
        <item name="colorOnSurface">@color/chord_picker_title</item>
        <item name="colorOnSurfaceVariant">@color/chord_picker_label</item>
        <item name="android:textColorPrimary">@color/chord_picker_title</item>
        <item name="android:textColorSecondary">@color/chord_picker_label</item>
        <item name="android:textColor">@color/chord_picker_title</item>
        <item name="colorControlNormal">@color/chord_picker_wheel_unselected</item>
    </style>

    <style name="ThemeOverlay.PianoLab.ChordPickerWheel" parent="ThemeOverlay.Material3.Light">
        <item name="android:textColorPrimary">@color/chord_picker_wheel_selected</item>
        <item name="android:textColorSecondary">@color/chord_picker_wheel_unselected</item>
        <item name="android:textColor">@color/chord_picker_wheel_selected</item>
        <item name="android:textColorHint">@color/chord_picker_wheel_unselected</item>
        <item name="colorControlNormal">@color/chord_picker_wheel_unselected</item>
        <item name="colorAccent">@color/chord_picker_wheel_selected</item>
    </style>
</resources>
