<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.PianoLab" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/piano_primary</item>
        <item name="colorPrimaryVariant">@color/piano_primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/piano_accent</item>
        <item name="colorSecondaryVariant">@color/piano_accent_light</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/piano_primary_dark</item>
        <!-- Background color -->
        <item name="android:windowBackground">@color/piano_background</item>
        <!-- Customize your theme here. -->
    </style>
</resources>