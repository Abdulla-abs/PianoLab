<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- 自定义功能栏 -->
    <LinearLayout
        android:id="@+id/ll_custom_action_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tuner_back_home"
            android:padding="12dp"
            android:scaleType="fitCenter"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/beat_switch_tone"
            android:layout_marginEnd="8dp"/>

        <Spinner
            android:id="@+id/spinner_tone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:entries="@array/tone_options"/>

    </LinearLayout>

    <!-- 顶部：放射波形视图 -->

    <!-- 返回按钮：用于 demo 返回主界面 -->
    <com.example.pianolab.feature.beat.view.RadialPulseView
        android:id="@+id/radial_pulse_view"
        android:layout_width="0dp"
        android:layout_height="220dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_custom_action_bar" />

    <!-- xml -->
    <LinearLayout
        android:id="@+id/ll_bpm_group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/radial_pulse_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 左侧组：BPM 标签 + 值（占可用宽度） -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:layout_weight="2"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_bpm_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BPM = " />

            <TextView
                android:id="@+id/tv_bpm_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="120"
                android:textStyle="bold"
                android:layout_marginStart="4dp"/>
            <TextView
                android:id="@+id/tv_tempo_marking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Allegro(快板)"
                android:layout_marginStart="8dp"
                android:textStyle="italic"
                android:importantForAccessibility="no" />

        </LinearLayout>

        <!-- 中间竖直分割线，作为视觉间隔 -->
        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@android:color/darker_gray"
            android:alpha="0.6" />

        <!-- 右侧组：图标 + 四分音符数值 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:layout_weight="1"
            android:gravity="center">

            <ImageView
                android:id="@+id/iv_crochet_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/crotchet" />
            <TextView
                android:id="@+id/tv_crochet_equals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="="
                android:textStyle="normal"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tv_crochet_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="120"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>
    <SeekBar
        android:id="@+id/seekbar_bpm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="270"
        app:layout_constraintTop_toBottomOf="@id/ll_bpm_group"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:id="@+id/ll_beats_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/seekbar_bpm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 左侧：紧凑的 拍号：4/4 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_beats_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="拍号："
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tv_beats_value"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="8dp"
                android:text="4/4"
                android:textStyle="bold" />
        </LinearLayout>



        <!-- 占位，推送右侧控件到最右 -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 描述滑块当前效果的文本（可由 Activity 动态更新） -->
        <TextView
            android:id="@+id/tv_accent_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="强化重拍"
            android:textSize="14sp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical" />

        <!-- 右侧：滑块式切换（内嵌文字 + 外部描述） -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_accent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:showText="true"
            android:textOn="强化"
            android:textOff="普通"
            android:contentDescription="强化重拍切换" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_special_rhythm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/ll_beats_row"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="0dp">

        <!-- 新增的描述文本 -->
        <TextView
            android:id="@+id/tv_special_rhythm_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="特殊节奏型"
            android:layout_marginEnd="4dp" />

        <!-- 新增的下拉选择控件 -->
        <Spinner
            android:id="@+id/spinner_special_rhythm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:entries="@array/special_rhythm_options"
            android:prompt="@string/select_special_rhythm"
            android:layout_marginStart="4dp" />
    </LinearLayout>


    <ToggleButton
        android:id="@+id/toggle_play"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textOn="停止"
        android:textOff="开始"
        app:layout_constraintTop_toBottomOf="@id/ll_beats_row"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="45dp" />




</androidx.constraintlayout.widget.ConstraintLayout>
