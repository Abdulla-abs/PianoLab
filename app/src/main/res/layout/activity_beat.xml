<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/piano_background"> <!-- 1. 应用清爽灰白背景 -->

    <!-- 顶部自定义功能栏 -->
    <LinearLayout
        android:id="@+id/ll_custom_action_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back_black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tuner_back_home"
            android:padding="12dp"
            android:scaleType="fitCenter"
            app:tint="@color/text_primary"/> <!-- 图标着色 -->

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/beat_switch_tone"
            android:textColor="@color/piano_primary"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"/>

        <Spinner
            android:id="@+id/spinner_tone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:entries="@array/tone_options"/>
    </LinearLayout>

    <!-- 放射波形视图 -->
    <!-- 高度为0dp，它会自动填充顶部栏和底部控制台之间的所有空间 -->
    <com.example.pianolab.feature.beat.view.RadialPulseView
        android:id="@+id/radial_pulse_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_custom_action_bar"
        app:layout_constraintBottom_toTopOf="@+id/cl_controls_container"/>

    <!-- 底部控制区域容器 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_controls_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_panel"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- BPM 显示组 -->
        <LinearLayout
            android:id="@+id/ll_bpm_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 左侧组：BPM -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_bpm_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bpm_equal"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/piano_primary"/> <!-- 使用主色调 -->

                <TextView
                    android:id="@+id/tv_bpm_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_clickable_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="120"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    tools:ignore="UseCompatTextViewDrawableXml" />
            </LinearLayout>

            <!-- 术语 -->
            <TextView
                android:id="@+id/tv_tempo_marking"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Allegro"
                android:layout_marginHorizontal="8dp"
                android:textStyle="italic"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:gravity="left"
                android:importantForAccessibility="no" />

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@android:color/darker_gray"
                android:alpha="0.6" />

            <!-- 右侧组：音符值 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_crochet_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/crotchet"
                    app:tint="@color/piano_primary"/>

                <TextView
                    android:id="@+id/tv_crochet_equals"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/equal"
                    android:textColor="@color/piano_primary"
                    android:textStyle="bold"
                    android:layout_marginHorizontal="4dp"/>

                <TextView
                    android:id="@+id/tv_crochet_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_clickable_chip"
                    android:gravity="center"
                    android:text="120"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:clickable="true"
                    android:focusable="true"
                    tools:ignore="UseCompatTextViewDrawableXml" />
            </LinearLayout>
        </LinearLayout>

        <!-- 进度条 -->
        <!-- 调整 marginTop 为 32dp，增加间距 -->
        <SeekBar
            android:id="@+id/seekbar_bpm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:max="270"
            android:layout_marginTop="32dp"
            android:progressTint="@color/piano_accent"
            android:thumbTint="@color/piano_accent"
            app:layout_constraintTop_toBottomOf="@id/ll_bpm_group"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 拍号行 -->
        <!-- 调整 marginTop 为 24dp -->
        <LinearLayout
            android:id="@+id/ll_beats_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/seekbar_bpm"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tv_beats_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="拍号"
                android:textColor="@color/piano_primary"
                android:textStyle="bold"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tv_beats_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_clickable_chip"
                android:drawableEnd="@android:drawable/arrow_down_float"
                android:drawablePadding="4dp"
                android:drawableTint="@color/text_secondary"
                android:gravity="center"
                android:text="4/4"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:clickable="true"
                android:focusable="true"
                tools:ignore="UseCompatTextViewDrawableXml" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_accent_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/emphasize_heavy"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/piano_primary"
                android:layout_marginEnd="8dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_accent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="@color/piano_accent"
                android:checked="true" />
        </LinearLayout>

        <!-- 特殊节奏型 -->
        <!-- 调整 marginTop 为 24dp -->
        <LinearLayout
            android:id="@+id/ll_special_rhythm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/ll_beats_row"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tv_special_rhythm_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/special_rhy"
                android:textStyle="bold"
                android:textColor="@color/piano_primary"
                android:layout_marginEnd="12dp" />

            <Spinner
                android:id="@+id/spinner_special_rhythm"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:entries="@array/special_rhythm_options" />
        </LinearLayout>

        <!-- 播放按钮 -->
        <!-- 调整 marginTop 为 32dp，并应用醒目的背景 -->
        <ToggleButton
            android:id="@+id/toggle_play"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_play_button"
            android:textOn="@string/stop"
            android:textOff="@string/start"
            android:textColor="@color/text_on_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/ll_special_rhythm"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
