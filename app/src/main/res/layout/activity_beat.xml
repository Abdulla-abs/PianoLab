<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- 顶部：放射波形视图 -->

    <!-- 返回按钮：用于 demo 返回主界面 -->
    <com.example.pianolab.feature.beat.view.RadialPulseView
        android:id="@+id/radial_pulse_view"
        android:layout_width="0dp"
        android:layout_height="220dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btn_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="返回"
        app:layout_constraintTop_toBottomOf="@id/radial_pulse_view"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="节拍器 (Demo)"
        android:textAppearance="?attr/textAppearanceHeadline6"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/radial_pulse_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_bpm_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BPM"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tv_bpm_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="120"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <SeekBar
        android:id="@+id/seekbar_bpm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="270"
        app:layout_constraintTop_toBottomOf="@id/tv_bpm_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tv_beats_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="每小节拍数"
        app:layout_constraintTop_toBottomOf="@id/seekbar_bpm"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tv_beats_value"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="4/4"
        android:textStyle="bold"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/seekbar_bpm"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

    <ToggleButton
        android:id="@+id/toggle_play"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textOn="停止"
        android:textOff="开始"
        app:layout_constraintTop_toBottomOf="@id/tv_beats_value"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tv_current_beat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="拍: -"
        app:layout_constraintTop_toBottomOf="@id/tv_beats_value"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="说明：水平布局在平板上显示更好。此为最小 demo 布局，后续会替换美观版。"
        android:textSize="12sp"
        android:textColor="#666"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
