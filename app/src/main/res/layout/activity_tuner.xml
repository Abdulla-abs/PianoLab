<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.example.pianolab.feature.tuner.viewmodel.TunerViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/black"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="4dp">

            <ImageButton
                android:id="@+id/button_back"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.6"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/tuner_back_home"
                android:scaleType="centerInside"
                app:tint="@android:color/white" />


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tuner_setting_auto_detect"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:maxLines="1" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_auto_detect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:checked="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tuner_setting_auto_stop"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:maxLines="1" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_auto_stop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:checked="true"
                    />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ref_standard_group"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="标准频率: "
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="440HZ"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:maxLines="1" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_ref_standard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:checked="false"
                    android:showText="true"
                    android:textOff="440Hz"
                    android:textOn="442Hz" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="442HZ"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:maxLines="1" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/wave_display_group"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="波形显示:"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:maxLines="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="频域"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:maxLines="1" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_wave_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:checked="false"
                    android:showText="true"
                    android:textOn="频域"
                    android:textOff="时域" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="时域"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:maxLines="1" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/insight_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <com.example.pianolab.feature.tuner.view.DeviationRulerView
                android:id="@+id/deviation_ruler"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.6"
                android:layout_marginEnd="8dp"
                android:background="#26FFFFFF"
                android:padding="8dp" />
            <com.example.pianolab.feature.tuner.view.WaveformView
                android:id="@+id/waveform_placeholder"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.4"
                android:layout_marginEnd="8dp"
                android:background="#11FFFFFF" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/piano_section"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.2"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <HorizontalScrollView
                android:id="@+id/piano_preview_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                android:fillViewport="true"
                android:overScrollMode="never">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">

                    <com.example.pianolab.feature.virtual_piano.view.PianoView
                        android:id="@+id/preview_piano"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@android:color/black" />
                </FrameLayout>
            </HorizontalScrollView>


            <LinearLayout
                android:id="@+id/note_info_column"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.35"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/text_current_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text='@{viewModel.tunerState.displayNote}'
                    android:textColor="@android:color/white"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_detectedNote_freq"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text='@{@string/tuner_detectedNote_frequency(viewModel.tunerState.displayFrequency)}'
                    android:textColor="@android:color/white" />

                <TextView
                    android:id="@+id/text_curr_freq"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@android:color/holo_red_light"
                    android:text='@{@string/tuner_current_frequency(viewModel.tunerState.measuredFrequency)}' />
                <TextView
                    android:id="@+id/text_deviation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@android:color/holo_red_light"
                    android:text='@{@string/tuner_deviation(viewModel.tunerState.deviationCents)}' />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.22"
                android:gravity="center"
                android:orientation="vertical">
                <ToggleButton
                    android:id="@+id/toggle_listening_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textOn='@string/tuner_stop_listening'
                    android:textOff='@string/tuner_start_listening'
                    android:checked='@{viewModel.tunerState.listening}' />

                <Button
                    android:id="@+id/change_curr_pitch_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text='播放当前参考音' />


                <Button
                    android:id="@+id/button_play_reference"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tuner_play_reference" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</layout>
