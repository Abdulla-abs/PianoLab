<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:id="@+id/content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurfaceContainer"
            app:contentInsetEnd="0dp"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/tuner_title"
            app:titleTextAppearance="@style/TextAppearance.PianoLab.TitleLarge">

            <ImageButton
                android:id="@+id/btn_toolbar_menu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/spacing_margin_mobile"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/tuner_open_settings"
                android:padding="12dp"
                android:src="@drawable/ic_more_vert"
                app:tint="?attr/colorPrimary" />
        </com.google.android.material.appbar.MaterialToolbar>

        <LinearLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="@dimen/tuner_content_spacing"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.6"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_tuning_meter"
                    style="@style/Widget.PianoLab.Beat.SettingsCard"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1.2"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:shapeAppearance="@style/ShapeAppearance.Beat.Settings.Single">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipChildren="true"
                        android:clipToPadding="true"
                        android:padding="@dimen/spacing_margin_mobile">

                        <LinearLayout
                            android:id="@+id/meter_header"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_marginBottom="@dimen/tuner_meter_header_spacing"
                            android:gravity="top"
                            android:orientation="horizontal"
                            app:layout_constraintBottom_toTopOf="@id/deviation_ruler"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="top"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/text_note_name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:fontFamily="serif"
                                    android:maxLines="1"
                                    android:text="@string/none_symbol"
                                    android:textAppearance="@style/TextAppearance.PianoLab.DisplayLarge"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textStyle="bold"
                                    app:autoSizeMaxTextSize="@dimen/tuner_note_name_max_size"
                                    app:autoSizeMinTextSize="@dimen/tuner_note_name_min_size"
                                    app:autoSizeStepGranularity="2sp"
                                    app:autoSizeTextType="uniform"
                                    tools:text="A4" />
                            </LinearLayout>

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="12dp"
                                        android:gravity="center_horizontal"
                                        android:minWidth="@dimen/tuner_meter_stat_column_min_width"
                                        android:text="@string/tuner_label_ref_freq"
                                        android:textAppearance="@style/TextAppearance.PianoLab.LabelSmall"
                                        android:textColor="?attr/colorOnSurfaceVariant" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="12dp"
                                        android:gravity="center_horizontal"
                                        android:minWidth="@dimen/tuner_meter_stat_column_min_width"
                                        android:text="@string/tuner_label_measured_freq"
                                        android:textAppearance="@style/TextAppearance.PianoLab.LabelSmall"
                                        android:textColor="?attr/colorOnSurfaceVariant" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="12dp"
                                        android:gravity="center_horizontal"
                                        android:minWidth="@dimen/tuner_meter_stat_column_min_width"
                                        android:text="@string/tuner_label_deviation"
                                        android:textAppearance="@style/TextAppearance.PianoLab.LabelSmall"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:baselineAligned="true"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/text_ref_freq_value"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="12dp"
                                        android:fontFamily="monospace"
                                        android:gravity="center_horizontal"
                                        android:minWidth="@dimen/tuner_meter_stat_column_min_width"
                                        android:textAppearance="@style/TextAppearance.PianoLab.BodyMedium"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textStyle="bold"
                                        tools:text="440.00 Hz" />

                                    <TextView
                                        android:id="@+id/text_measured_freq_value"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="12dp"
                                        android:fontFamily="monospace"
                                        android:gravity="center_horizontal"
                                        android:minWidth="@dimen/tuner_meter_stat_column_min_width"
                                        android:textAppearance="@style/TextAppearance.PianoLab.BodyMedium"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textStyle="bold"
                                        tools:text="0.00 Hz" />

                                    <TextView
                                        android:id="@+id/text_deviation_value"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="12dp"
                                        android:fontFamily="monospace"
                                        android:gravity="center_horizontal"
                                        android:minWidth="@dimen/tuner_meter_stat_column_min_width"
                                        android:textAppearance="@style/TextAppearance.PianoLab.BodyMedium"
                                        android:textColor="@color/tuner_cursor_green"
                                        android:textStyle="bold"
                                        tools:text="0.0 音分" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <com.example.pianolab.feature.tuner.view.DeviationRulerView
                            android:id="@+id/deviation_ruler"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/tuner_meter_ruler_height"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_waveform"
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/tuner_content_spacing"
                    android:layout_weight="0.9"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_tuner_oscilloscope">

                        <com.example.pianolab.feature.tuner.view.WaveformView
                            android:id="@+id/waveform_view"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <TextView
                            android:id="@+id/text_waveform_idle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/tuner_oscilloscope_idle"
                            android:textAppearance="@style/TextAppearance.PianoLab.LabelSmall"
                            android:textColor="?attr/colorOutline" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panel_actions"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/tuner_content_spacing"
                android:layout_weight="0.4"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_action_start"
                    style="@style/Widget.PianoLab.Beat.SettingsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Beat.Settings.Top">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/beat_settings_item_padding_h"
                        android:paddingVertical="@dimen/beat_settings_item_padding_v">

                        <FrameLayout
                            android:layout_width="@dimen/beat_settings_badge_size"
                            android:layout_height="@dimen/beat_settings_badge_size"
                            android:background="@drawable/bg_beat_settings_badge_emerald">

                            <ImageView
                                android:layout_width="@dimen/beat_settings_icon_size"
                                android:layout_height="@dimen/beat_settings_icon_size"
                                android:layout_gravity="center"
                                android:contentDescription="@string/tuner_start_listening"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_mic"
                                app:tint="@color/beat_settings_badge_emerald_tint" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/text_action_start"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:text="@string/tuner_start_listening"
                            android:textAppearance="@style/TextAppearance.PianoLab.BodyLarge"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_action_play_ref"
                    style="@style/Widget.PianoLab.Beat.SettingsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/beat_settings_section_spacing"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Beat.Settings.Middle">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/beat_settings_item_padding_h"
                        android:paddingVertical="@dimen/beat_settings_item_padding_v">

                        <FrameLayout
                            android:layout_width="@dimen/beat_settings_badge_size"
                            android:layout_height="@dimen/beat_settings_badge_size"
                            android:background="@drawable/bg_beat_settings_badge_sky">

                            <ImageView
                                android:layout_width="@dimen/beat_settings_icon_size"
                                android:layout_height="@dimen/beat_settings_icon_size"
                                android:layout_gravity="center"
                                android:contentDescription="@string/play_curr_ref_note"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_play_arrow"
                                app:tint="@color/beat_settings_badge_sky_tint" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:text="@string/play_curr_ref_note"
                            android:textAppearance="@style/TextAppearance.PianoLab.BodyLarge"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_action_play_standard"
                    style="@style/Widget.PianoLab.Beat.SettingsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/beat_settings_section_spacing"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Beat.Settings.Bottom">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/beat_settings_item_padding_h"
                        android:paddingVertical="@dimen/beat_settings_item_padding_v">

                        <FrameLayout
                            android:layout_width="@dimen/beat_settings_badge_size"
                            android:layout_height="@dimen/beat_settings_badge_size"
                            android:background="@drawable/bg_beat_settings_badge_rose">

                            <ImageView
                                android:layout_width="@dimen/beat_settings_icon_size"
                                android:layout_height="@dimen/beat_settings_icon_size"
                                android:layout_gravity="center"
                                android:contentDescription="@string/tuner_play_reference"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_music_note"
                                app:tint="@color/beat_settings_badge_rose_tint" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:text="@string/tuner_play_reference"
                            android:textAppearance="@style/TextAppearance.PianoLab.BodyLarge"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/drawer_settings"
        android:layout_width="@dimen/virtual_piano_drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_piano_settings_drawer"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/drawer_settings_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_margin_mobile"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:text="@string/tuner_settings_title"
                android:textAppearance="@style/TextAppearance.PianoLab.TitleLarge"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PianoLab.Beat.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Beat.Settings.Top">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/beat_settings_item_padding_h"
                    android:paddingVertical="@dimen/beat_settings_item_padding_v">

                    <FrameLayout
                        android:layout_width="@dimen/beat_settings_badge_size"
                        android:layout_height="@dimen/beat_settings_badge_size"
                        android:background="@drawable/bg_beat_settings_badge_sky">

                        <ImageView
                            android:layout_width="@dimen/beat_settings_icon_size"
                            android:layout_height="@dimen/beat_settings_icon_size"
                            android:layout_gravity="center"
                            android:contentDescription="@string/tuner_setting_auto_detect"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_feature_tuner"
                            app:tint="@color/beat_settings_badge_sky_tint" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tuner_setting_auto_detect"
                            android:textAppearance="@style/TextAppearance.PianoLab.BodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tuner_setting_auto_detect_desc"
                            android:textAppearance="@style/TextAppearance.PianoLab.LabelSmall"
                            android:textColor="?attr/colorOutline" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_auto_detect"
                        style="@style/Widget.PianoLab.Beat.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:minHeight="32dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PianoLab.Beat.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/beat_settings_section_spacing"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Beat.Settings.Middle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/beat_settings_item_padding_h"
                    android:paddingVertical="@dimen/beat_settings_item_padding_v">

                    <FrameLayout
                        android:layout_width="@dimen/beat_settings_badge_size"
                        android:layout_height="@dimen/beat_settings_badge_size"
                        android:background="@drawable/bg_beat_settings_badge_emerald">

                        <ImageView
                            android:layout_width="@dimen/beat_settings_icon_size"
                            android:layout_height="@dimen/beat_settings_icon_size"
                            android:layout_gravity="center"
                            android:contentDescription="@string/tuner_setting_auto_stop"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_beat_accent"
                            app:tint="@color/beat_settings_badge_emerald_tint" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tuner_setting_auto_stop"
                            android:textAppearance="@style/TextAppearance.PianoLab.BodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tuner_setting_auto_stop_desc"
                            android:textAppearance="@style/TextAppearance.PianoLab.LabelSmall"
                            android:textColor="?attr/colorOutline" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_auto_stop"
                        style="@style/Widget.PianoLab.Beat.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:minHeight="32dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PianoLab.Beat.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/beat_settings_section_spacing"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Beat.Settings.Bottom">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/beat_settings_item_padding_h"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tuner_ref_freq_a4"
                        android:textAppearance="@style/TextAppearance.PianoLab.BodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggle_group_freq"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:checkedButton="@id/btn_freq_440"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_freq_440"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/tuner_freq_440" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_freq_442"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/tuner_freq_442" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
