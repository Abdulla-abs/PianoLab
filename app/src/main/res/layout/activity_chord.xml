<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:scaleType="center"
            android:adjustViewBounds="true" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="8"
            android:max="1000" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.6"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="撤回"
                android:textColor="@color/white"
                android:gravity="center" />

            <ImageButton
                android:id="@+id/button_backout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/backout"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="撤回"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true" />

        </LinearLayout>

        <!-- 音名：标签 + 开关（成组，权重 1.4），左侧留一点间距与前一组分开 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.6"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="重置"
                android:textColor="@color/white"
                android:gravity="center" />

            <ImageButton
            android:id="@+id/button_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/reset"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="重置"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 水平滚动容器，包含自定义 PianoView -->
        <com.example.pianolab.feature.virtual_piano.view.NonScrollableHorizontalScrollView
            android:id="@+id/hs_piano"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="10.5"
            android:fillViewport="true"
            android:overScrollMode="never">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent">

                <com.example.pianolab.feature.virtual_piano.view.PianoView
                    android:id="@+id/piano_view"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent" />

            </FrameLayout>
        </com.example.pianolab.feature.virtual_piano.view.NonScrollableHorizontalScrollView>

        <!-- chord_displayer 区域 -->
        <LinearLayout
            android:id="@+id/chord_displayer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="6"
            android:orientation="horizontal"
            android:background="#222222"
            android:padding="8dp">

            <!-- 左边：存放 SVG 素材 -->
            <ImageView
                android:id="@+id/iv_chord_svg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="Chord Diagram"
                android:src="@drawable/ic_launcher_foreground" />

            <!-- 右边：TextView 和 Button 竖直排列 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_chord_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chord Name"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btn_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Action" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</LinearLayout>
