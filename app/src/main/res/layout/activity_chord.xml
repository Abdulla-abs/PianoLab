<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:id="@+id/content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurfaceContainer"
            app:contentInsetEnd="0dp"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/home_feature_chord"
            app:titleTextAppearance="@style/TextAppearance.PianoLab.TitleLarge">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_toolbar_undo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/back_out"
                    android:padding="12dp"
                    android:src="@drawable/ic_undo"
                    app:tint="?attr/colorPrimary" />

                <ImageButton
                    android:id="@+id/btn_toolbar_reset"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/reset"
                    android:padding="12dp"
                    android:src="@drawable/ic_restart"
                    app:tint="?attr/colorPrimary" />

                <ImageButton
                    android:id="@+id/btn_toolbar_menu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/spacing_margin_mobile"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/chord_open_settings"
                    android:padding="12dp"
                    android:src="@drawable/ic_more_vert"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <LinearLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="@dimen/tuner_content_spacing"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_keyboard"
                style="@style/Widget.PianoLab.Beat.SettingsCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="9.5"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:shapeAppearance="@style/ShapeAppearance.Beat.Settings.Single">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/piano_stage_background"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_margin_mobile">

                    <com.example.pianolab.feature.virtual_piano.view.PianoRangeOverviewView
                        android:id="@+id/piano_range_overview"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/virtual_piano_overview_height"
                        android:layout_marginBottom="@dimen/virtual_piano_overview_gap_below"
                        android:contentDescription="@string/virtual_piano_range_overview" />

                    <com.example.pianolab.feature.virtual_piano.view.SlicePianoKeyboardView
                        android:id="@+id/piano_view"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/desc_piano_keys" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/panel_chord_display"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/tuner_content_spacing"
                android:layout_weight="6"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_staff_chord"
                    style="@style/Widget.PianoLab.Beat.SettingsCard"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:shapeAppearance="@style/ShapeAppearance.Beat.Settings.Single">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_margin_mobile">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="3.4"
                            android:orientation="vertical">

                            <com.example.pianolab.feature.chord.view.StaffView
                                android:id="@+id/staff_g_clef"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <com.example.pianolab.feature.chord.view.StaffView
                                android:id="@+id/staff_f_clef"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="2"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_chord_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:text="@string/none_symbol"
                                android:textAppearance="@style/TextAppearance.PianoLab.DisplayMedium"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="C Maj" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_play_chord"
                    style="@style/Widget.PianoLab.Beat.SettingsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tuner_content_spacing"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Beat.Settings.Single">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/beat_settings_item_padding_h"
                        android:paddingVertical="@dimen/beat_settings_item_padding_v">

                        <FrameLayout
                            android:layout_width="@dimen/beat_settings_badge_size"
                            android:layout_height="@dimen/beat_settings_badge_size"
                            android:background="@drawable/bg_beat_settings_badge_sky">

                            <ImageView
                                android:layout_width="@dimen/beat_settings_icon_size"
                                android:layout_height="@dimen/beat_settings_icon_size"
                                android:layout_gravity="center"
                                android:contentDescription="@string/play_chord"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_play_arrow"
                                app:tint="@color/beat_settings_badge_sky_tint" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:text="@string/play_chord"
                            android:textAppearance="@style/TextAppearance.PianoLab.BodyLarge"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/drawer_settings"
        android:layout_width="@dimen/virtual_piano_drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_piano_settings_drawer"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/drawer_settings_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_margin_mobile"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:text="@string/chord_settings_title"
                android:textAppearance="@style/TextAppearance.PianoLab.TitleLarge"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/chord_section_mode"
                android:textAppearance="@style/TextAppearance.PianoLab.LabelLarge"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PianoLab.Beat.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Beat.Settings.Single">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/beat_settings_item_padding_h"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chord_mode_label"
                        android:textAppearance="@style/TextAppearance.PianoLab.BodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/text_chord_mode_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/chord_mode_detect_desc"
                        android:textAppearance="@style/TextAppearance.PianoLab.LabelSmall"
                        android:textColor="?attr/colorOutline" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggle_group_chord_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:checkedButton="@id/btn_mode_detect"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_mode_detect"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/detect_chord" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_mode_construct"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/construct_chord" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="18dp"
                android:paddingBottom="8dp"
                android:text="@string/chord_section_accidental"
                android:textAppearance="@style/TextAppearance.PianoLab.LabelLarge"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PianoLab.Beat.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Beat.Settings.Single">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/beat_settings_item_padding_h"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/accidental_mode"
                        android:textAppearance="@style/TextAppearance.PianoLab.BodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/text_accidental_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/chord_accidental_sharp_desc"
                        android:textAppearance="@style/TextAppearance.PianoLab.LabelSmall"
                        android:textColor="?attr/colorOutline" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggle_group_accidental"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:checkedButton="@id/btn_accidental_sharp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_accidental_sharp"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/sharp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_accidental_flat"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/flat" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.drawerlayout.widget.DrawerLayout>
