<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <import type="android.view.View"/>
        <variable
            name="viewModel"
            type="com.example.pianolab.feature.chord.viewmodel.ChordViewModel" />
    </data>

<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:scaleType="center"
            android:adjustViewBounds="true" />

        <!-- 修改：权重从 8 减小到 6，腾出空间 -->
        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="6"
            android:max="1000" />


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_control_capsule"
            android:paddingEnd="10dp"
            android:paddingStart="4dp"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detect_chord"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_chord_func_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/construct_chord"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>


        <!-- 修改：权重从 2.5 增加到 3.5，确保内容完整显示 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3.5"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="4dp"
            android:background="@drawable/bg_control_capsule"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/accidental_mode"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginEnd="4dp"/>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/sharp_white"
                android:contentDescription="@string/sharp"
                android:scaleType="fitCenter"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_accidental_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:thumbTint="@color/white"
                android:trackTint="#88FFFFFF" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/flat_white"
                android:contentDescription="@string/flat"
                android:scaleType="fitCenter"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.6"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/back_out"
                android:textColor="@color/white" />

            <ImageButton
                android:id="@+id/button_backout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/backout"
                android:padding="4dp"
                android:background="@drawable/bg_clickable_ic_dark"
                android:contentDescription="@string/back_out"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.6"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reset"
                android:textColor="@color/white"
                android:gravity="center" />

            <ImageButton
                android:id="@+id/button_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/reset"
                android:padding="4dp"
                android:background="@drawable/bg_clickable_ic_dark"
                android:contentDescription="@string/reset"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 水平滚动容器，包含自定义 PianoView -->
        <com.example.pianolab.feature.virtual_piano.view.NonScrollableHorizontalScrollView
            android:id="@+id/hs_piano"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="9.5"
            android:fillViewport="true"
            android:overScrollMode="never">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent">

                <com.example.pianolab.feature.chord.view.ChordPianoView
                    android:id="@+id/piano_view"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent" />

            </FrameLayout>
        </com.example.pianolab.feature.virtual_piano.view.NonScrollableHorizontalScrollView>

        <!-- chord_displayer 区域 -->
        <LinearLayout
            android:id="@+id/chord_displayer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="6"
            android:orientation="horizontal"
            android:background="#E0E0E0"
            android:padding="8dp">

            <!-- 左边：存放 SVG 素材 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3.4"
                android:orientation="vertical"
                >

                <com.example.pianolab.feature.chord.view.StaffView
                    android:id="@+id/staff_g_clef"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <com.example.pianolab.feature.chord.view.StaffView
                    android:id="@+id/staff_f_clef"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>


            <!-- 右边：TextView 和 Button 竖直排列 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:gravity="center"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/tv_chord_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/none_symbol"
                    android:textColor="#000000"
                    android:background="@{viewModel.isChordFuncMode ? @drawable/bg_manual_note_blue : null}"
                    android:clickable="@{viewModel.isChordFuncMode}"
                    android:focusable="@{viewModel.isChordFuncMode}"
                    android:textSize="27sp" />

                <Button
                    android:id="@+id/btn_play_chord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/play_chord" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</LinearLayout>
</layout>
