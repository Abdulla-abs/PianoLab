<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:scaleType="center"
            android:adjustViewBounds="true" />

        <!-- 权重从 8 降为 5，释放空间 -->
        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="5"
            android:max="1000" />

        <!-- 延音控制组：权重从 1.4 提升至 2.2 -->

        <!-- 音名控制组：权重从 1.4 提升至 2.2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1.45"
            android:background="@drawable/bg_control_capsule"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tv_tenuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/tenuto"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_sustain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:checked="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.45"
            android:background="@drawable/bg_control_capsule"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tv_pitch_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pitch_name"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_show_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:layout_marginStart="4dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- 水平滚动容器，包含自定义 PianoView -->
    <com.example.pianolab.feature.virtual_piano.view.NonScrollableHorizontalScrollView
        android:id="@+id/hs_piano"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <com.example.pianolab.feature.virtual_piano.view.PianoView
                android:id="@+id/piano_view"
                android:layout_width="wrap_content"
                android:layout_height="match_parent" />

        </FrameLayout>
    </com.example.pianolab.feature.virtual_piano.view.NonScrollableHorizontalScrollView>
</LinearLayout>
