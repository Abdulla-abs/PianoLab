<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:scaleType="center"
            android:adjustViewBounds="true" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="8"
            android:max="1000" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.4"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/tv_tenuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="延音"
                android:textColor="@color/white"
                android:gravity="center" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_sustain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- 音名：标签 + 开关（成组，权重 1.4），左侧留一点间距与前一组分开 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.4"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tv_pitch_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="音名"
                android:textColor="@color/white"
                android:gravity="center" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_show_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:layout_marginStart="6dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- 水平滚动容器，包含自定义 PianoView -->
    <com.example.pianolab.feature.virtual_piano.view.NonScrollableHorizontalScrollView
        android:id="@+id/hs_piano"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <com.example.pianolab.feature.virtual_piano.view.PianoView
                android:id="@+id/piano_view"
                android:layout_width="wrap_content"
                android:layout_height="match_parent" />

        </FrameLayout>
    </com.example.pianolab.feature.virtual_piano.view.NonScrollableHorizontalScrollView>
</LinearLayout>
