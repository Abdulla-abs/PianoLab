<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:id="@+id/content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:contentInsetEnd="0dp"
            app:elevation="0dp"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/home_feature_piano"
            app:titleTextAppearance="@style/TextAppearance.PianoLab.TitleLarge">

            <ImageButton
                android:id="@+id/btn_toolbar_menu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/spacing_margin_mobile"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/virtual_piano_open_settings"
                android:padding="12dp"
                android:src="@drawable/ic_more_vert"
                app:tint="?attr/colorPrimary" />
        </com.google.android.material.appbar.MaterialToolbar>

        <FrameLayout
            android:id="@+id/piano_stage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/piano_stage_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <com.example.pianolab.feature.virtual_piano.view.PianoRangeOverviewView
                    android:id="@+id/piano_range_overview"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/virtual_piano_overview_height"
                    android:layout_marginTop="@dimen/virtual_piano_overview_margin_top"
                    android:layout_marginBottom="@dimen/virtual_piano_overview_gap_below"
                    android:contentDescription="@string/virtual_piano_range_overview" />

                <com.example.pianolab.feature.virtual_piano.view.SlicePianoKeyboardView
                    android:id="@+id/piano_view"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/desc_piano_keys" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/drawer_settings"
        android:layout_width="@dimen/virtual_piano_drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_piano_settings_drawer"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_margin_mobile"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:text="@string/virtual_piano_settings_title"
                android:textAppearance="@style/TextAppearance.PianoLab.TitleLarge"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/virtual_piano_section_display"
                android:textAppearance="@style/TextAppearance.PianoLab.LabelLarge"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PianoLab.Beat.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Beat.Settings.Single">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/beat_settings_item_padding_h"
                    android:paddingVertical="@dimen/beat_settings_item_padding_v">

                    <FrameLayout
                        android:layout_width="@dimen/beat_settings_badge_size"
                        android:layout_height="@dimen/beat_settings_badge_size"
                        android:background="@drawable/bg_beat_settings_badge_sky">

                        <ImageView
                            android:layout_width="@dimen/beat_settings_icon_size"
                            android:layout_height="@dimen/beat_settings_icon_size"
                            android:layout_gravity="center"
                            android:contentDescription="@string/pitch_name"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_music_note"
                            app:tint="@color/beat_settings_badge_sky_tint" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="@string/pitch_name"
                        android:textAppearance="@style/TextAppearance.PianoLab.BodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_show_note"
                        style="@style/Widget.PianoLab.Beat.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:minHeight="32dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="18dp"
                android:paddingBottom="8dp"
                android:text="@string/beat_section_playback"
                android:textAppearance="@style/TextAppearance.PianoLab.LabelLarge"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PianoLab.Beat.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Beat.Settings.Single">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/beat_settings_item_padding_h"
                    android:paddingVertical="@dimen/beat_settings_item_padding_v">

                    <FrameLayout
                        android:layout_width="@dimen/beat_settings_badge_size"
                        android:layout_height="@dimen/beat_settings_badge_size"
                        android:background="@drawable/bg_beat_settings_badge_emerald">

                        <ImageView
                            android:layout_width="@dimen/beat_settings_icon_size"
                            android:layout_height="@dimen/beat_settings_icon_size"
                            android:layout_gravity="center"
                            android:contentDescription="@string/tenuto"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_beat_accent"
                            app:tint="@color/beat_settings_badge_emerald_tint" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="@string/tenuto"
                        android:textAppearance="@style/TextAppearance.PianoLab.BodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_sustain"
                        style="@style/Widget.PianoLab.Beat.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:minHeight="32dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="18dp"
                android:paddingBottom="8dp"
                android:text="@string/virtual_piano_section_keyboard"
                android:textAppearance="@style/TextAppearance.PianoLab.LabelLarge"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PianoLab.Beat.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Beat.Settings.Single">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/beat_settings_item_padding_h"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/virtual_piano_key_size"
                        android:textAppearance="@style/TextAppearance.PianoLab.BodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_key_scale"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:stepSize="0.05"
                        android:value="1"
                        android:valueFrom="0.5"
                        android:valueTo="1.5"
                        app:thumbColor="?attr/colorPrimary"
                        app:trackColorActive="?attr/colorPrimary"
                        app:trackColorInactive="?attr/colorSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.drawerlayout.widget.DrawerLayout>
